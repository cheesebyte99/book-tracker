rules_version='2';service cloud.firestore{match /databases/{database}/documents{function x(d,f){return !d.keys().hasAny([f]);}function o(d,f,n){return x(d,f)||(d[f] is string&&d[f].size()<=n);}function i(d,f){return x(d,f)||(d[f] is int&&d[f]<=20000);}function z(d,a,b){return d[a] is timestamp&&d[b] is timestamp;}function D(v){return v is string&&v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');}function t(v){return v==null||v.matches('^[0-2][0-9]:[0-5][0-9]$');}function b(d){return d.keys().hasOnly(['id','title','author','status','date','rating','tags','memo','started_at','photo','updatedAt'])&&d.id is int&&d.title.size()<=300&&d.status in ['완독','읽는 중','읽고 싶음']&&d.rating is int&&d.rating<=5&&d.photo.size()<=900000&&d.updatedAt is timestamp;}function p(d){return d.keys().hasOnly(['id','dataUrl','note','addedAt','updatedAt'])&&d.id is string&&d.dataUrl.size()<=900000&&(x(d,'note')||d.note.size()<=120)&&z(d,'addedAt','updatedAt');}function e(d){return d.keys().hasOnly(['title','date','allDay','startTime','endTime','color','memo','author','createdAt','updatedAt','endDate'])&&d.title.size()<=60&&D(d.date)&&d.allDay is bool&&t(d.startTime)&&t(d.endTime)&&d.color is string&&d.color.matches('^[A-Za-z0-9_-]{1,40}$')&&d.memo.size()<=300&&d.author.size()<=20&&(x(d,'endDate')||(D(d.endDate)&&d.endDate>d.date));}function c(d){return d.keys().hasOnly(['name','color','order','createdAt','updatedAt'])&&d.name is string&&d.name.size()>=1&&d.name.size()<=20&&d.color is string&&d.color.matches('^#[0-9a-fA-F]{6}$')&&d.order is int&&d.order>=0&&d.order<100&&z(d,'createdAt','updatedAt');}function am(d){return d.keys().hasOnly(['name','cloudinary','createdAt','updatedAt'])&&(x(d,'name')||d.name.size()<=60)&&(x(d,'cloudinary')||(d.cloudinary is map&&d.cloudinary.keys().hasOnly(['cloudName','uploadPreset'])&&o(d.cloudinary,'cloudName',60)&&o(d.cloudinary,'uploadPreset',60)&&d.cloudinary.keys().hasAll(['cloudName','uploadPreset'])))&&z(d,'createdAt','updatedAt');}function ad(d){return d.keys().hasOnly(['date','title','place','memo','author','createdAt','updatedAt'])&&D(d.date)&&d.title is string&&d.title.size()<=100&&o(d,'place',80)&&o(d,'memo',1000)&&d.author is string&&d.author.size()<=20&&z(d,'createdAt','updatedAt');}function ap(d){return d.keys().hasOnly(['url','thumbUrl','publicId','caption','takenAt','width','height','author','addedAt','updatedAt'])&&d.url is string&&d.url.size()>8&&d.url.size()<=900000&&o(d,'thumbUrl',300000)&&o(d,'publicId',200)&&o(d,'caption',200)&&o(d,'takenAt',40)&&i(d,'width')&&i(d,'height')&&o(d,'author',20)&&z(d,'addedAt','updatedAt');}match /bookshelves/{r}/books/{k}{allow read,delete:if true;allow create,update:if b(request.resource.data);match /gallery/{g}{allow read,delete:if true;allow create,update:if p(request.resource.data);}}match /rooms/{r}/events/{v}{allow read,delete:if true;allow create,update:if e(request.resource.data);}match /rooms/{r}/categories/{q}{allow read,delete:if true;allow create,update:if q.matches('^[A-Za-z0-9_-]{1,40}$')&&c(request.resource.data);}match /albums/{r}{allow read:if true;allow create,update:if am(request.resource.data);match /days/{y}{allow read,delete:if true;allow create,update:if ad(request.resource.data);match /photos/{h}{allow read,delete:if true;allow create,update:if ap(request.resource.data);}}}}}
