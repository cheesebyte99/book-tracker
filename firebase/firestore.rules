rules_version='2';service cloud.firestore{match /databases/{database}/documents{function t(v){return v==null||v.matches('^[0-2][0-9]:[0-5][0-9]$');}function b(d){return d.keys().hasOnly(['id','title','author','status','date','rating','tags','memo','started_at','photo','updatedAt'])&&d.id is int&&d.title.size()<=300&&d.status in ['완독','읽는 중','읽고 싶음']&&d.rating is int&&d.rating<=5&&d.photo.size()<=900000&&d.updatedAt is timestamp;}function p(d){return d.keys().hasOnly(['id','dataUrl','note','addedAt','updatedAt'])&&d.id is string&&d.dataUrl.size()<=900000&&(!d.keys().hasAny(['note'])||d.note.size()<=120)&&d.addedAt is timestamp&&d.updatedAt is timestamp;}function e(d){return d.keys().hasOnly(['title','date','allDay','startTime','endTime','color','memo','author','createdAt','updatedAt','endDate'])&&d.title.size()<=60&&d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')&&d.allDay is bool&&t(d.startTime)&&t(d.endTime)&&d.color in ['meet','trip','anniv','etc']&&d.memo.size()<=300&&d.author.size()<=20&&(!d.keys().hasAny(['endDate'])||(d.endDate is string&&d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')&&d.endDate>d.date));}function am(d){return d.keys().hasOnly(['name','cloudinary','createdAt','updatedAt'])&&(!d.keys().hasAny(['name'])||d.name.size()<=60)&&(!d.keys().hasAny(['cloudinary'])||(d.cloudinary is map&&d.cloudinary.keys().hasOnly(['cloudName','uploadPreset'])&&d.cloudinary.cloudName is string&&d.cloudinary.cloudName.size()<=60&&d.cloudinary.uploadPreset is string&&d.cloudinary.uploadPreset.size()<=60))&&d.createdAt is timestamp&&d.updatedAt is timestamp;}function ad(d){return d.keys().hasOnly(['date','title','place','memo','author','createdAt','updatedAt'])&&d.date is string&&d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')&&d.title is string&&d.title.size()<=100&&(!d.keys().hasAny(['place'])||(d.place is string&&d.place.size()<=80))&&(!d.keys().hasAny(['memo'])||(d.memo is string&&d.memo.size()<=1000))&&d.author is string&&d.author.size()<=20&&d.createdAt is timestamp&&d.updatedAt is timestamp;}function ap(d){return d.keys().hasOnly(['url','thumbUrl','publicId','caption','takenAt','width','height','author','addedAt','updatedAt'])&&d.url is string&&d.url.size()>8&&d.url.size()<=900000&&(!d.keys().hasAny(['thumbUrl'])||(d.thumbUrl is string&&d.thumbUrl.size()<=300000))&&(!d.keys().hasAny(['publicId'])||(d.publicId is string&&d.publicId.size()<=200))&&(!d.keys().hasAny(['caption'])||(d.caption is string&&d.caption.size()<=200))&&(!d.keys().hasAny(['takenAt'])||(d.takenAt is string&&d.takenAt.size()<=40))&&(!d.keys().hasAny(['width'])||(d.width is int&&d.width<=20000))&&(!d.keys().hasAny(['height'])||(d.height is int&&d.height<=20000))&&(!d.keys().hasAny(['author'])||(d.author is string&&d.author.size()<=20))&&d.addedAt is timestamp&&d.updatedAt is timestamp;}match /bookshelves/{roomId}/books/{bookId}{allow read,delete:if true;allow create,update:if b(request.resource.data);}match /bookshelves/{roomId}/books/{bookId}/gallery/{photoId}{allow read,delete:if true;allow create,update:if p(request.resource.data);}match /rooms/{roomId}/events/{eventId}{allow read,delete:if true;allow create,update:if e(request.resource.data);}match /albums/{roomId}{allow read:if true;allow create,update:if am(request.resource.data);match /days/{dayId}{allow read,delete:if true;allow create,update:if ad(request.resource.data);match /photos/{photoId}{allow read,delete:if true;allow create,update:if ap(request.resource.data);}}}}}
